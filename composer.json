{
    "name": "spiggle/filament-portal-snapshot",
    "description": "Filament 4/5 plugin for creating, scheduling, restoring, exporting and remotely storing database snapshots — built on spatie/laravel-db-snapshots.",
    "type": "library",
    "version": "1.0.0",
    "license": "MIT",
    "homepage": "https://github.com/skillbobby/Spiggle-Filament-Portal-Snapshot",
    "support": {
        "issues": "https://github.com/skillbobby/Spiggle-Filament-Portal-Snapshot/issues",
        "source": "https://github.com/skillbobby/Spiggle-Filament-Portal-Snapshot"
    },
    "keywords": ["spiggle", "laravel", "filament", "filament-plugin", "filament-v4", "filament-v5", "database", "snapshots", "db-snapshots", "demo-reset", "spatie"],
    "authors": [{"name": "Spiggle", "email": "skillbobby@outlook.com", "role": "Developer"}],
    "require": {
        "php": "^8.2",
        "filament/filament": "^4.0|^5.0",
        "illuminate/console": ">=11.0",
        "illuminate/contracts": ">=11.0",
        "illuminate/database": ">=11.0",
        "illuminate/mail": ">=11.0",
        "illuminate/notifications": ">=11.0",
        "illuminate/support": ">=11.0",
        "spatie/laravel-db-snapshots": "^2.6",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Spiggle\\FilamentPortalSnapshot\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Spiggle\\FilamentPortalSnapshot\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Spiggle\\FilamentPortalSnapshot\\FilamentPortalSnapshotServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "pest",
        "format": "pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
